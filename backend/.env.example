# ── DinToGo Environment Configuration ─────────────────────────────
# Copy this file to .env and fill in your values

NODE_ENV=development
PORT=5000

# ── PostgreSQL ────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dintogo
DB_USER=postgres
DB_PASS=postgres

# ── Frontend URL (CORS) ──────────────────────────────────────────
CLIENT_URL=http://localhost:3000

# ── JWT Authentication ───────────────────────────────────────────
# IMPORTANT: Use a strong random string in production (min 32 chars)
JWT_SECRET=change_me_to_a_strong_random_secret_in_production
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# ── Cloudinary (image uploads — optional for MVP) ────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email / SMTP (Nodemailer — optional for MVP) ────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
